			    CONTAINSSTRING(Categoria, "Artigos De Natal"), "🎄",
			    CONTAINSSTRING(Categoria, "Market Place"), "🏪",
			    CONTAINSSTRING(Categoria, "Seguros"), "🛡️",
			
			    -- Default (Se algo não casar)
			    "📦"
			)
